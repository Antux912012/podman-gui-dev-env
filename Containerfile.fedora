FROM fedora:latest

ARG USERNAME=devuser
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN dnf install -y @development-tools \
    git curl sudo gdb valgrind vim nano \
    libX11-devel wayland-devel libxkbcommon-devel \
    mesa-dri-drivers glx-utils xeyes wayland-utils \
    flatpak flatpak-builder ostree elfutils appstream libappstream-glib desktop-file-utils \
    dbus-x11 fuse3 ca-certificates \
    && flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
    && dnf clean all

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

RUN dnf install -y \
    vala vala-devel valadoc libgee-devel json-glib-devel libsoup3-devel \
    gtk4-devel gtk4-devel-tools libadwaita-devel glib2-devel \
    gobject-introspection-devel \
    meson ninja-build pkgconf-pkg-config gettext \
    rust cargo rustfmt clippy rust-src rust-analyzer clang clang-devel \
    && dnf clean all

USER $USERNAME
WORKDIR /workspace
