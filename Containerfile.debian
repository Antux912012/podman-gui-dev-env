FROM debian:bookworm

ARG USERNAME=devuser
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN apt-get update && apt-get install -y \
    build-essential git curl sudo gdb valgrind vim nano \
    libx11-6 libx11-dev libwayland-client0 libwayland-dev libxkbcommon-dev \
    mesa-utils libgl1-mesa-dri x11-apps wayland-utils \
    flatpak flatpak-builder ostree elfutils appstream appstream-compose desktop-file-utils \
    dbus-x11 fuse3 ca-certificates \
    && flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

RUN apt-get update && apt-get install -y \
    valac valadoc libgee-0.8-dev libjson-glib-dev libsoup-3.0-dev \
    libgtk-4-dev libgtk-4-bin libadwaita-1-dev libglib2.0-dev \
    gobject-introspection libgirepository1.0-dev \
    meson ninja-build pkg-config gettext \
    rustc cargo rustfmt rust-clippy rust-src clang libclang-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    python3-gi python3-gi-cairo python3-requests python3-pip \
    gir1.2-gtk-4.0 gir1.2-adw-1 \
    bc bison flex libssl-dev libelf-dev libncurses-dev libdw-dev \
    libudev-dev libpci-dev libiberty-dev autoconf dwarves pahole \
    zstd xz-utils lz4 cpio rsync kmod fakeroot dpkg-dev debhelper \
    devscripts llvm lld sbsigntool mokutil openssl linux-base \
    initramfs-tools pciutils usbutils \
    && rm -rf /var/lib/apt/lists/*

USER $USERNAME
WORKDIR /workspace
